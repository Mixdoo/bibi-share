{
  "governance": {
    "routing_rules": [
      {
        "id": "6abf6a68-1788-47d1-aac8-63b9663a0324",
        "name": "四源价格优先",
        "enabled": true,
        "chain_rule": false,
        "scope": "virtual_key",
        "scope_id": "REPLACE_WITH_VK_ID",
        "priority": 10,
        "cel_expression": "model == \"demo-model\" && \"x-demo-policy\" in headers && headers[\"x-demo-policy\"] == \"cost\"",
        "targets": [
          {
            "provider": "source-a",
            "model": "demo-model",
            "weight": 1
          }
        ],
        "fallbacks": [
          "source-b/demo-model",
          "source-c/demo-model",
          "source-d/demo-model"
        ]
      },
      {
        "id": "fdf0ce20-3375-49a6-8e15-ef045cf15cb1",
