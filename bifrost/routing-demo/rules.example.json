        "chain_rule": false,
        "scope": "virtual_key",
        "scope_id": "REPLACE_WITH_VK_ID",
        "priority": 20,
        "cel_expression": "model == \"demo-model\" && \"x-demo-policy\" in headers && headers[\"x-demo-policy\"] == \"stable\"",
        "targets": [
          {
            "provider": "source-d",
            "model": "demo-model",
            "weight": 1
          }
        ],
        "fallbacks": [
          "source-b/demo-model",
          "source-c/demo-model",
          "source-a/demo-model"
        ]
      },
      {
